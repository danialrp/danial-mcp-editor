# ── Private, never published ────────────────────────────────────────────────
# Anything machine-specific, personal or secret lives in these folders.
/.private/
/secrets/
/local/
.env
.env.*
!.env.example
*.pem
*.p12
*.key
*.mobileprovision
*.provisionprofile
*.keychain
*.keychain-db

# ── macOS ───────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
.fseventsd

# ── Xcode ───────────────────────────────────────────────────────────────────
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xccheckout
DerivedData/
build/
*.moved-aside
*.hmap
*.ipa
*.dSYM
*.dSYM.zip
*.xcresult
*.profraw
*.gcno
*.gcda
*.trace
timeline.xctimeline
playground.xcworkspace

# ── Swift Package Manager ───────────────────────────────────────────────────
.build/
.swiftpm/
Packages/
*.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/configuration/

# ── Editors and agent tooling ───────────────────────────────────────────────
.idea/
.vscode/
*.swp
*~
.claude/settings.local.json
.claude/worktrees/

# ── Media, caches and renders ───────────────────────────────────────────────
# Footage, exports and editor projects are user data, not source.
# Small test fixtures are allowed under Tests/Fixtures/.
*.mov
*.mp4
*.m4v
*.mkv
*.webm
*.mxf
*.wav
*.aif
*.aiff
*.mp3
*.m4a
*.flac
*.cube
*.braw
!Tests/Fixtures/**
/renders/
/exports/
/cache/
/tmp/

# ── Logs and crash reports ──────────────────────────────────────────────────
*.log
*.crash
*.ips

# Small synthetic test fixtures (generated by scripts/make-probe-media.sh, no footage)
!Tests/*/Fixtures/
!Tests/*/Fixtures/*
